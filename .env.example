# --- Obligatoire en production ---
SECRET_KEY=change-moi-par-une-longue-chaine-aleatoire
DEBUG=False
SITE_URL=https://ton-domaine.up.railway.app
ALLOWED_HOSTS=.up.railway.app,ton-domaine.com
CSRF_TRUSTED_ORIGINS=https://*.up.railway.app,https://ton-domaine.com
# Fourni automatiquement par les services Railway
DATABASE_URL=
REDIS_URL=
# Fichiers envoyés (photos, MP3) : monter un volume Railway sur ce dossier
MEDIA_ROOT=/data/media
TIME_ZONE=Europe/Rome

# --- E-mails de l'Alerter (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.exemple.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Miel <no-reply@ton-domaine.com>

# --- Telegram (rappels + photos du mur des vœux) ---
TELEGRAM_BOT_TOKEN=

# --- WhatsApp Business API (préparé, facultatif) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
